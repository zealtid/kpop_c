# API
PORT=3000
DATABASE_URL=postgres://kpop:kpop@localhost:5432/kpop_c
JWT_SECRET=change-me-in-prod
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000
ADMIN_TOKEN=dev-admin
DATA_DIR=./api/data

# OPS-0 admin shell (username/password + allowlist). Never commit production passwords.
# Local default after seed: ops / ops-dev (non-production only).
OPS_ADMIN_USER=ops
OPS_ADMIN_PASSWORD=ops-dev
# OPS_ADMIN_PASSWORD_HASH=
# Optional comma-separated usernames. If unset, ops_users.allowlisted is used.
# OPS_ALLOWLIST=ops

# WeChat login (leave empty in non-prod to use mock:openid codes)
# Production plug-in: set both, then POST /auth/wx-login { code } from wx.login()
# calls https://api.weixin.qq.com/sns/jscode2session
WX_APPID=
WX_SECRET=

# Railway Bucket xingka-user-cards (S3-compatible reference vars). Names only — never commit secrets.
# If unset, custom card images store under DATA_DIR/custom
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
