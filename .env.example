# API
PORT=3000
DATABASE_URL=postgres://kpop:kpop@localhost:5432/kpop_c
JWT_SECRET=change-me-in-prod
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000
ADMIN_TOKEN=dev-admin
DATA_DIR=./api/data

# OPS-0 admin shell (username/password + allowlist). Never commit production passwords.
# Local default after seed: ops / ops-dev (non-production only).
OPS_ADMIN_USER=ops
OPS_ADMIN_PASSWORD=ops-dev
# OPS_ADMIN_PASSWORD_HASH=
# Optional comma-separated usernames. If unset, ops_users.allowlisted is used.
# OPS_ALLOWLIST=ops

# P3 #9 贡献积分：图鉴投稿首次审核通过时记入（默认 1 分/张，OQ-P3-1）。驳回为 0。不回填历史通过（OQ-P3-2）。非现金。
# CONTRIBUTION_POINTS_PER_APPROVED_CARD=1

# OPS-2 A07: optional per-group published-release allowlist.
# Format: bts:<release-uuid>[,<uuid>][;slug:<uuid>]
# When a group is listed, publishing / importing releases outside the slice is blocked.
# Unset = unconstrained (draft next-album rows can still be created).
# CATALOG_RELEASE_ALLOWLIST=

# CORS: extra Admin / H5 origins (comma-separated exact Origin strings).
# localhost / 127.0.0.1 and https://*.up.railway.app are always allowed.
# H5_PUBLIC_URL origin is also merged in automatically.
# CORS_ORIGINS=https://admin.example.com,https://h5.example.com

# Admin SPA (Vite, build-time). Production Railway service `admin` should set:
# VITE_API_BASE=https://api-production-0818.up.railway.app

# H5 SPA (UGC-2a). Production Railway service `h5` should set VITE_API_BASE at build.
# API uses H5_PUBLIC_URL to redirect QR `/share/landing` and OAuth return.
# H5_PUBLIC_URL=https://h5-production.up.railway.app

# WeChat login (leave empty in non-prod to use mock:openid codes)
# Production plug-in: set both, then POST /auth/wx-login { code } from wx.login()
# calls https://api.weixin.qq.com/sns/jscode2session
WX_APPID=
WX_SECRET=

# WeChat web OAuth for H5 (Official Account / 网页授权). Distinct AppID from the mini program.
# Bind both apps to the same WeChat Open Platform so unionid maps to the same user_id.
# Callback domain must allow WX_WEB_REDIRECT_URI (default ${PUBLIC_BASE_URL}/auth/wx-web/callback).
# WX_WEB_APPID=
# WX_WEB_SECRET=
# WX_WEB_REDIRECT_URI=https://api-production-0818.up.railway.app/auth/wx-web/callback

# H5「打开小程序」跳转（外部微信 H5，不是小程序 web-view）
# 最强路径：WX_APPID + WX_SECRET → API 调用 generate_urllink / generatescheme（需在微信公众平台开通 URL Link / URL Scheme）
# 次强：公众号 JS-SDK 开放标签 wx-open-launch-weapp，另需：
#   WX_WEB_APPID / WX_WEB_SECRET（公众号）、WX_MINI_GH_ID（小程序原始 ID，gh_ 开头）
#   公众号 JS 接口安全域名填 H5 域名；公众号关联该小程序
# 兜底静态票：WX_URL_SCHEME=weixin://dl/business/?t=...（不含动态 path，只作保底）
# WX_URL_SCHEME=
# WX_MINI_GH_ID=

# Railway Bucket xingka-user-cards (S3-compatible reference vars). Names only — never commit secrets.
# If unset, custom card images store under DATA_DIR/custom
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# UGC-2b-VLM（火山方舟 / 豆包视觉）。仅服务端；不要写进小程序。
# Railway 生产必须设置，否则宫格识别会降级单卡投稿。
# ARK_API_KEY=
# ARK_VISION_MODEL=doubao-seed-1.6-vision
# 推荐填控制台「推理接入点」ID（ep-…），或带日期的视觉模型 ID（如 doubao-seed-1-6-vision-250815）
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# GRID_VLM_PROVIDER=doubao
# GRID_VLM_TIMEOUT_MS=18000
# GRID_VLM_DAILY_LIMIT=20

