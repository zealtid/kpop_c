.mini-actions { margin-top: 8rpx; font-size: 20rpx; }
.search { margin: 20rpx 0 8rpx; }

.group-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 8rpx;
}

.group-logo {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  flex-shrink: 0;
  background: var(--color-bg-muted);
  object-fit: cover;
}

.group-logo.letter {
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.batch-bar {
  margin: 8rpx 0 20rpx;
  position: sticky;
  top: 0;
  z-index: 2;
  background: var(--color-bg-page);
  padding: 12rpx 0;
}

.btn.slim {
  padding: 10rpx 28rpx;
  width: auto;
}

.batch-bar .btn.ghost.slim {
  margin-left: auto;
}

.batch-bar .btn + .btn {
  margin-top: 0;
}

.sel {
  outline: 6rpx solid var(--color-brand);
}

.benefit-badge {
  position: absolute;
  top: 0;
  right: 0;
  z-index: 1;
  font-size: 18rpx;
  line-height: 1.2;
  padding: 8rpx 12rpx 8rpx 14rpx;
  border-bottom-left-radius: 12rpx;
  background: var(--color-warning);
  color: var(--color-text-inverse);
  font-weight: 700;
  letter-spacing: 1rpx;
}
