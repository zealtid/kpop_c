.mini-actions { margin-top: 8rpx; font-size: 22rpx; }
.search { margin: 20rpx 0 8rpx; }

.group-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 8rpx;
}

.group-logo {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  flex-shrink: 0;
  background: var(--color-bg-muted);
  object-fit: cover;
}

.group-logo.letter {
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.release-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.release-title-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx 12rpx;
  flex: 1;
  min-width: 0;
  line-height: 1.35;
}

.release-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.release-title-row .kind-chip {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  font-size: 22rpx;
  line-height: 1.2;
}

.release-inline {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--color-text-secondary);
}

.release-chevron {
  flex-shrink: 0;
  width: 36rpx;
  text-align: center;
  font-size: 24rpx;
  line-height: 1;
  color: var(--color-text-tertiary);
  transform: rotate(-90deg);
}

.release-chevron.open {
  transform: rotate(0deg);
}

.meta-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.meta-chip {
  display: inline-flex;
  align-items: center;
  max-width: 100%;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: var(--color-brand-soft);
  color: var(--color-brand);
  font-size: 24rpx;
  line-height: 1.3;
  font-weight: 600;
  box-sizing: border-box;
}

.meta-chip.benefit {
  background: var(--color-warning);
  color: var(--color-text-inverse);
}

.grid3 .tile {
  min-width: 0;
}

.tile-name {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.35;
  color: var(--color-text-primary);
  font-weight: 600;
}

.tile-chips {
  display: flex;
  flex-wrap: nowrap;
  min-width: 0;
  width: 100%;
  margin-top: 8rpx;
  overflow: hidden;
}

.tile-chips .meta-chip {
  display: block;
  flex: 0 1 auto;
  min-width: 0;
  max-width: 100%;
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.tile-chips .meta-chip text {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.batch-bar {
  margin: 8rpx 0 20rpx;
  position: sticky;
  top: 0;
  z-index: 2;
  background: var(--color-bg-page);
  padding: 8rpx 0;
}

.btn.slim {
  padding: 4rpx 16rpx;
  width: auto;
  font-size: 22rpx;
  line-height: 1.3;
}

.batch-bar .btn.ghost.slim {
  margin-left: auto;
}

.batch-bar .btn + .btn {
  margin-top: 0;
}

.sel {
  outline: 6rpx solid var(--color-brand);
}
