.mini-actions { margin-top: 8rpx; font-size: 22rpx; }
.search { margin: 20rpx 0 8rpx; }

.group-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 8rpx;
}

.group-logo {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  flex-shrink: 0;
  background: var(--color-bg-muted);
  object-fit: cover;
}

.group-logo.letter {
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.release-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.release-title {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.35;
  color: var(--color-text-primary);
}

.release-link {
  flex-shrink: 0;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--color-brand);
}

.meta-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.meta-chip {
  display: inline-flex;
  align-items: center;
  max-width: 100%;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: var(--color-brand-soft);
  color: var(--color-brand);
  font-size: 24rpx;
  line-height: 1.3;
  font-weight: 600;
  box-sizing: border-box;
}

.meta-chip.benefit {
  background: var(--color-warning);
  color: var(--color-text-inverse);
}

.tile-name {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.35;
  color: var(--color-text-primary);
  font-weight: 600;
}

.tile-chips {
  margin-top: 8rpx;
}

.tile-chips .meta-chip {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
}

.batch-bar {
  margin: 8rpx 0 20rpx;
  position: sticky;
  top: 0;
  z-index: 2;
  background: var(--color-bg-page);
  padding: 12rpx 0;
}

.btn.slim {
  padding: 10rpx 28rpx;
  width: auto;
}

.batch-bar .btn.ghost.slim {
  margin-left: auto;
}

.batch-bar .btn + .btn {
  margin-top: 0;
}

.sel {
  outline: 6rpx solid var(--color-brand);
}

.benefit-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  z-index: 1;
  font-size: 22rpx;
  line-height: 1.2;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: var(--color-warning);
  color: var(--color-text-inverse);
  font-weight: 700;
  letter-spacing: 1rpx;
}
