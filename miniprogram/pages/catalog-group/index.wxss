.mini-actions { margin-top: 8rpx; font-size: 20rpx; color: #ff8fb8; }
.search { margin: 20rpx 0 8rpx; }

.batch-bar {
  margin: 8rpx 0 20rpx;
  position: sticky;
  top: 0;
  z-index: 2;
  background: #121016;
  padding: 12rpx 0;
}

.btn.slim {
  padding: 10rpx 28rpx;
  width: auto;
}

.sel {
  outline: 6rpx solid #ff6b9d;
}

.benefit-badge {
  position: absolute;
  top: 0;
  right: 0;
  z-index: 1;
  font-size: 18rpx;
  line-height: 1.2;
  padding: 8rpx 12rpx 8rpx 14rpx;
  border-bottom-left-radius: 12rpx;
  background: rgba(18, 16, 22, 0.88);
  color: #f5c36b;
  font-weight: 700;
  letter-spacing: 1rpx;
}
