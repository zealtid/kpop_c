<view class="page">
  <view class="h1">{{group.nameZh}}</view>
  <view wx:if="{{group.scopeNote}}" class="footnote">{{group.scopeNote}}</view>
  <input class="search" placeholder="在本组内搜索" confirm-type="search" bindconfirm="onSearch"/>

  <view wx:for="{{releases}}" wx:key="id" class="card">
    <view class="row">
      <view>
        <view>{{item.title}}</view>
        <view class="muted">{{item.released_on}} · {{item.kind}}</view>
      </view>
    </view>
    <view class="grid3" style="margin-top:16rpx">
      <view class="tile" wx:for="{{item.templates}}" wx:for-item="t" wx:key="id">
        <view class="ph" style="background: {{t.memberColor}}">
          <image wx:if="{{t.mainImageUrl}}" src="{{t.mainImageUrl}}" mode="aspectFill"/>
        </view>
        <view class="muted">{{t.memberNameEn}}</view>
        <view class="tag">{{t.version}}</view>
        <view class="row mini-actions">
          <text catchtap="ownOne" data-id="{{t.id}}">拥有</text>
          <text catchtap="wantOne" data-id="{{t.id}}">想要</text>
        </view>
      </view>
    </view>
  </view>
</view>
