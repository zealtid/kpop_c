<view class="page">
  <view class="group-head">
    <image wx:if="{{group.logoSrc}}" class="group-logo" src="{{group.logoSrc}}" mode="aspectFill"/>
    <view wx:else class="group-logo letter" style="background: {{group.logoColor}}">{{group.initial}}</view>
    <view>
      <view class="h1">{{group.nameZh}}</view>
      <view wx:if="{{group.scopeNote}}" class="footnote">{{group.scopeNote}}</view>
    </view>
  </view>
  <input class="search" placeholder="在本组内搜索" placeholder-style="color:#98A2B3" confirm-type="search" bindconfirm="onSearch"/>
  <view wx:if="{{pageLoading}}" class="page-loading">加载中…</view>

  <view class="row batch-bar">
    <block wx:if="{{selectMode}}">
      <view class="muted">已选 {{selected.length}}</view>
      <view class="btn slim" bindtap="batchOwn">批量拥有</view>
      <view class="btn ghost slim" bindtap="exitSelect">完成</view>
    </block>
    <view wx:else class="btn ghost slim" bindtap="enterSelect">多选</view>
  </view>

  <view wx:for="{{releases}}" wx:key="id" class="card">
    <view class="release-head">
      <view>
        <view class="release-title">{{item.title}}</view>
        <view class="meta-chips">
          <view wx:if="{{item.releasedOnLabel}}" class="meta-chip">{{item.releasedOnLabel}}</view>
          <view wx:if="{{item.kind}}" class="meta-chip">{{item.kind}}</view>
        </view>
      </view>
      <view class="release-link" hover-class="nav-hover" hover-start-time="20" hover-stay-time="80" catchtap="openRelease" data-id="{{item.id}}">特典对照 →</view>
    </view>
    <view class="grid3" style="margin-top:16rpx">
      <view class="tile" wx:for="{{item.templates}}" wx:for-item="t" wx:key="id" hover-class="nav-hover" hover-start-time="20" hover-stay-time="80" bindtap="onTileTap" data-id="{{t.id}}">
        <view class="ph {{selectMode && t.on ? 'sel' : ''}}" style="background: {{t.memberColor}}">
          <image wx:if="{{t.mainImageUrl}}" src="{{t.mainImageUrl}}" mode="aspectFill"/>
          <view wx:if="{{t.isBenefit}}" class="benefit-badge">特典</view>
        </view>
        <view class="tile-name">{{t.memberNameEn}}</view>
        <view class="meta-chips tile-chips">
          <view wx:if="{{t.isBenefit}}" class="meta-chip benefit">特典</view>
          <view wx:if="{{t.version}}" class="meta-chip">{{t.version}}</view>
        </view>
        <view wx:if="{{!selectMode}}" class="row mini-actions">
          <text class="own" catchtap="ownOne" data-id="{{t.id}}">拥有</text>
          <text class="want" catchtap="wantOne" data-id="{{t.id}}">想要</text>
        </view>
      </view>
    </view>
  </view>
</view>
