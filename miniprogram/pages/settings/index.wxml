<view class="page">
  <view wx:if="{{needsLogin}}" class="card">
    <view class="h1">未登录</view>
    <view class="muted">关注管理需要先登录。</view>
    <view wx:if="{{loginFailed}}" class="muted" style="margin-top:12rpx">登录失败，请重试</view>
    <view class="btn" style="margin-top:24rpx" bindtap="doLogin">{{loginBtnLabel}}</view>
  </view>

  <block wx:else>
    <view class="card row settings-row" hover-class="nav-hover" hover-start-time="20" hover-stay-time="80" bindtap="goFollowManage">
      <view>管理关注</view>
      <view class="muted">选择或调整关注的团体</view>
    </view>
  </block>
</view>
