<view class="page crop-page">
  <view class="h1">裁剪卡面</view>
  <view class="sub">固定 {{aspectLabel}} 竖图，不可跳过。双指缩放、拖动时边缘带阻尼。</view>

  <view class="presets">
    <view class="chip {{aspectLocked ? 'on' : ''}}">{{aspectLabel}}</view>
  </view>

  <view class="stage">
    <view class="frame" style="width: {{frameW}}px; height: {{frameH}}px;">
      <image
        wx:if="{{src}}"
        class="img"
        src="{{src}}"
        mode="scaleToFill"
        style="width: {{imgNatW}}px; height: {{imgNatH}}px; transform: translate3d({{tx}}px, {{ty}}px, 0) scale({{scale}});"
      />
      <view
        class="touch"
        bindtouchstart="onTouchStart"
        bindtouchmove="onTouchMove"
        bindtouchend="onTouchEnd"
        catchtouchmove="onTouchMove"
      />
    </view>
  </view>

  <canvas
    canvas-id="cropCanvas"
    class="offscreen"
    style="width: {{outW}}px; height: {{outH}}px;"
    disable-scroll="true"
  />

  <view class="muted hint" wx:if="{{preparing}}">正在准备预览…</view>
  <view class="btn {{busy || preparing ? 'off' : ''}}" bindtap="confirm">确认裁剪</view>
</view>
