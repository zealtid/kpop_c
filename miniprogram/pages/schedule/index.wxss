.chip-row {
  white-space: nowrap;
  margin: 20rpx 0 8rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  margin: 28rpx 0 12rpx;
}

.today-strip {
  white-space: nowrap;
}

.today-card {
  display: inline-block;
  width: 300rpx;
  margin-right: 16rpx;
  vertical-align: top;
  white-space: normal;
  background: var(--color-bg-elevated);
  border: 1rpx solid var(--color-border-subtle);
  border-radius: 20rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.today-kind {
  font-size: 20rpx;
  color: var(--color-brand);
}

.today-title {
  font-size: 28rpx;
  font-weight: 700;
  margin: 8rpx 0;
}

.countdown {
  margin-top: 12rpx;
  color: var(--color-danger);
  font-size: 24rpx;
  font-weight: 700;
}

.countdown.done {
  color: var(--color-text-secondary);
  font-weight: 400;
}

.strip-empty {
  margin: 8rpx 0 16rpx;
}

.day-label {
  color: var(--color-text-tertiary);
  font-size: 24rpx;
  margin: 8rpx 0 12rpx;
}

.ev-title {
  font-size: 28rpx;
  font-weight: 700;
}
