.placeholder {
  color: var(--color-text-tertiary);
}

.name-slot {
  font-size: 32rpx;
  margin-top: 12rpx;
}

.nickname-actions {
  margin-top: 20rpx;
  gap: 16rpx;
}

.btn.slim {
  flex: 1;
  margin: 0;
}

.row .btn + .btn {
  margin-top: 0;
}

.policy {
  margin-top: 16rpx;
  line-height: 1.5;
}

.follow-title {
  font-size: 32rpx;
}

.link {
  color: var(--color-brand);
  font-size: 26rpx;
}

.avatar-strip {
  display: flex;
  margin-top: 20rpx;
}

.avatar-dot {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  margin-right: 12rpx;
  color: var(--color-text-inverse);
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
