.placeholder {
  color: var(--color-text-tertiary);
}

.name-slot {
  font-size: 32rpx;
  margin-top: 12rpx;
}

.profile {
  padding: 20rpx 24rpx;
}

.profile-row {
  display: flex;
  align-items: center;
}

.avatar-btn {
  width: 104rpx;
  height: 104rpx;
  min-width: 104rpx;
  min-height: 104rpx;
  padding: 0;
  margin: 0;
  background: var(--color-bg-muted);
  border: none;
  border-radius: 50%;
  overflow: hidden;
  line-height: 0;
  font-size: 0;
}

.avatar-btn::after {
  border: none;
}

.avatar,
.avatar-ph {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  display: block;
}

.avatar-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-muted);
  color: var(--color-text-tertiary);
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
}

.profile-meta {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.profile-name {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.35;
}

.nickname-sync-wrap {
  position: relative;
  display: inline-block;
  margin-top: 10rpx;
}

.nickname-sync-btn {
  pointer-events: none;
  padding: 10rpx 28rpx;
  font-size: 24rpx;
}

.nickname-fill {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  z-index: 2;
}

.follow-title {
  font-size: 32rpx;
}

.link {
  color: var(--color-brand);
  font-size: 26rpx;
}

.avatar-strip {
  display: flex;
  margin-top: 20rpx;
}

.avatar-dot {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  margin-right: 12rpx;
  color: var(--color-text-inverse);
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-list {
  padding: 8rpx 8rpx 8rpx 28rpx;
  margin-top: 12rpx;
}

.action-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 104rpx;
  padding: 8rpx 20rpx 8rpx 0;
  border-bottom: 1rpx solid var(--color-border-subtle);
}

.action-row:last-child {
  border-bottom: none;
}

.action-label {
  font-size: 30rpx;
  line-height: 1.4;
  color: var(--color-text-primary);
}

.action-arrow {
  font-size: 40rpx;
  line-height: 1;
  color: var(--color-text-tertiary);
}
