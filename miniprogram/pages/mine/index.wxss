.placeholder {
  color: var(--color-text-tertiary);
}

.name-slot {
  font-size: 32rpx;
  margin-top: 12rpx;
}

.nickname-sync-wrap {
  position: relative;
  margin-top: 24rpx;
}

.nickname-sync-btn {
  pointer-events: none;
}

.nickname-fill {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  z-index: 2;
}

.follow-title {
  font-size: 32rpx;
}

.link {
  color: var(--color-brand);
  font-size: 26rpx;
}

.avatar-strip {
  display: flex;
  margin-top: 20rpx;
}

.avatar-dot {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  margin-right: 12rpx;
  color: var(--color-text-inverse);
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-list {
  padding: 8rpx 8rpx 8rpx 28rpx;
  margin-top: 12rpx;
}

.action-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 104rpx;
  padding: 8rpx 20rpx 8rpx 0;
  border-bottom: 1rpx solid var(--color-border-subtle);
}

.action-row:last-child {
  border-bottom: none;
}

.action-label {
  font-size: 30rpx;
  line-height: 1.4;
  color: var(--color-text-primary);
}

.action-arrow {
  font-size: 40rpx;
  line-height: 1;
  color: var(--color-text-tertiary);
}
