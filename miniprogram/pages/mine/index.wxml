<view class="page">
  <view wx:if="{{needsLogin}}" class="card">
    <view class="h1">未登录</view>
    <view class="h1 placeholder name-slot">{{displayName}}</view>
    <view class="muted">浏览「图鉴」无需登录。关注、可见性与缺卡反馈需要先登录。</view>
    <view wx:if="{{loginFailed}}" class="muted" style="margin-top:12rpx">登录失败，请重试</view>
    <view class="btn" style="margin-top:24rpx" bindtap="doLogin">{{loginBtnLabel}}</view>
  </view>

  <block wx:else>
    <view class="card profile">
      <view class="profile-row">
        <button
          class="avatar-btn"
          hover-class="none"
          open-type="chooseAvatar"
          bindchooseavatar="onChooseAvatar"
        >
          <image wx:if="{{hasAvatar}}" class="avatar" src="{{avatarSrc}}" mode="aspectFill"/>
          <view wx:else class="avatar-ph">星</view>
        </button>
        <view class="profile-meta">
          <view class="profile-name {{nicknameUnset ? 'placeholder' : ''}}">{{displayName}}</view>
          <view wx:if="{{nicknameUnset}}" class="nickname-sync-wrap">
            <view class="btn nickname-sync-btn">同步微信昵称</view>
            <input
              class="nickname-fill"
              type="nickname"
              maxlength="32"
              bindblur="onWxNicknameFill"
              bindnicknamereview="onNicknameReview"
            />
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{followCount > 0}}" class="card">
      <view class="row">
        <view class="h1 follow-title">{{followLabel}}</view>
        <view class="link" bindtap="goFollowManage">管理关注</view>
      </view>
      <view class="avatar-strip">
        <view
          wx:for="{{followPreview}}"
          wx:key="id"
          class="avatar-dot"
          style="background: {{item.logoColor}}"
        >{{item.initial}}</view>
      </view>
    </view>
    <view wx:else class="card">
      <view class="empty-title">还没有关注组合</view>
      <view class="empty-sub">选择喜欢的团体后，卡册会展示收集进度。</view>
      <view class="btn" bindtap="goFollowManage">去选择关注</view>
    </view>
  </block>

  <view class="card action-list">
    <view class="action-row" bindtap="goSettings">
      <text class="action-label">设置</text>
      <text class="action-arrow">›</text>
    </view>
    <view class="action-row" bindtap="goFeedback">
      <text class="action-label">文字反馈缺卡</text>
      <text class="action-arrow">›</text>
    </view>
    <view class="action-row" bindtap="goAbout">
      <text class="action-label">关于星卡</text>
      <text class="action-arrow">›</text>
    </view>
  </view>
</view>
