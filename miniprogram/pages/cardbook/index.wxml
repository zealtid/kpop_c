<view class="page">
  <view class="h1">我的卡册</view>
  <view class="sub">{{copy}}</view>
  <view class="muted" style="margin-top:12rpx">总览不提供搜索，请到「图鉴」检索专辑与模板。</view>

  <view class="btn add-custom" bindtap="addCustomCard">拍照加卡</view>

  <view wx:if="{{needsLogin}}" class="empty-state">
    <view class="empty-title">浏览图鉴无需登录</view>
    <view class="empty-sub">卡册进度需要登录。可先打开「图鉴」查看组合与卡片；标记拥有 / 想要 / 拍照加卡时会提示登录。</view>
    <view wx:if="{{loginFailed}}" class="empty-sub">登录失败，请重试</view>
    <view class="btn" bindtap="goCatalog">去图鉴</view>
    <view class="btn ghost" bindtap="doLogin">{{loginBtnLabel}}</view>
  </view>

  <block wx:else>
    <view wx:if="{{customCount > 0}}" class="custom-block">
      <view class="custom-head">
        <view class="tag">{{customLabel}}</view>
        <view class="muted">不计入上方官方进度</view>
      </view>
      <view class="grid3">
        <view class="tile" wx:for="{{customCards}}" wx:key="id" bindtap="openCustom" data-id="{{item.id}}">
          <view class="ph" style="background: {{item.memberColor || '#2a2233'}}" catchtap="openPreview" data-id="{{item.id}}">
            <image wx:if="{{item.mainImageUrl}}" src="{{item.mainImageUrl}}" mode="aspectFill"/>
            <view class="badge">{{item.badge}}</view>
            <view wx:if="{{item.moderationLabel}}" class="badge warn">{{item.moderationLabel}}</view>
          </view>
          <view class="muted">{{item.title || item.memberNameEn || '自定义卡'}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{emptyFollows}}" class="empty-state">
      <view class="empty-title">还没有关注组合</view>
      <view class="empty-sub">选择 1–3 个组合后，这里会显示收集进度。</view>
      <view class="btn" bindtap="goFollowPicker">去选择关注</view>
    </view>

    <block wx:else>
      <view wx:for="{{groups}}" wx:key="id" class="group-card" bindtap="openGroup" data-id="{{item.slug}}">
        <view class="left">
          <view class="dot" style="background: {{item.logoColor}}"></view>
          <view>
            <view class="name">{{item.nameZh}}</view>
            <view class="en">{{item.nameEn}}</view>
            <view wx:if="{{item.customBadge}}" class="tag">{{item.customLabel}}</view>
            <view wx:if="{{item.scopeNote}}" class="footnote">{{item.scopeNote}}</view>
          </view>
        </view>
        <view class="ring">
          <view class="pct">{{item.pct}}%</view>
          <view class="frac">{{item.progress.ownedDistinct}}/{{item.progress.publishedCount}}</view>
        </view>
      </view>
    </block>
  </block>
</view>
