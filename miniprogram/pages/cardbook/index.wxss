.album.page {
  padding: 24rpx 24rpx 40rpx;
}

.page-title {
  font-size: 44rpx;
  line-height: 1.2;
  margin-bottom: 20rpx;
}

.dual-entry {
  display: flex;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.dual-card {
  flex: 1;
  min-width: 0;
  border-radius: 32rpx;
  padding: 28rpx 24rpx 24rpx;
  box-sizing: border-box;
  min-height: 168rpx;
}

.dual-left {
  background: var(--color-brand-soft);
  border: 1rpx solid var(--color-border-subtle);
}

.dual-right {
  background: var(--color-brand);
  color: var(--color-text-inverse);
}

.dual-kicker {
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 0.04em;
  opacity: 0.78;
}

.dual-left .dual-kicker {
  color: var(--color-brand);
  opacity: 1;
}

.dual-title {
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.2;
}

.dual-left .dual-title {
  color: var(--color-text-primary);
}

.dual-count {
  margin-top: 10rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.dual-left .dual-count {
  color: var(--color-text-secondary);
}

.group-list {
  padding-top: 8rpx;
}

.group-card {
  display: flex;
  align-items: stretch;
  gap: 20rpx;
  background: var(--color-bg-elevated);
  border: 1rpx solid var(--color-border-subtle);
  border-radius: 32rpx;
  padding: 16rpx;
  margin-top: 16rpx;
  min-height: 220rpx;
  box-sizing: border-box;
}

.cover {
  position: relative;
  width: 168rpx;
  height: 252rpx;
  border-radius: 24rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: var(--color-bg-muted);
}

.cover-img {
  width: 100%;
  height: 100%;
  display: block;
}

.cover-ph {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: var(--color-text-inverse);
}

.cover-initial {
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1;
}

.cover-cta {
  font-size: 20rpx;
  font-weight: 700;
  opacity: 0.92;
}

.logo-badge {
  position: absolute;
  left: 10rpx;
  bottom: 10rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  background: var(--color-bg-elevated);
  border: 2rpx solid var(--color-bg-elevated);
}

.group-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 8rpx 8rpx 8rpx 0;
}

.name {
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bar {
  margin-top: 14rpx;
  height: 12rpx;
  width: 100%;
  background: var(--color-progress-track);
  border-radius: 999rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  background: var(--color-progress-fill);
  border-radius: 999rpx;
}

.group-body .footnote {
  margin-top: 10rpx;
  font-size: 20rpx;
}

.frac {
  margin-top: 8rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  line-height: 1.2;
}

.pct {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-brand);
  font-weight: 700;
}

.empty-state {
  margin-top: 32rpx;
  padding: 48rpx 32rpx;
}

.empty-actions {
  margin-top: 32rpx;
}

.empty-state .btn {
  margin-top: 0;
}

.empty-state .btn + .btn {
  margin-top: 16rpx;
}

.custom-block {
  margin-top: 36rpx;
}

.custom-head {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin-bottom: 8rpx;
}

.grid3 {
  margin: 0 -6rpx;
}

.grid3 .tile {
  padding: 6rpx;
}

.ph {
  padding-top: 150%;
  border-radius: 16rpx;
}

.tile-name {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.3;
  font-weight: 600;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tile-act {
  margin-top: 4rpx;
  min-height: 56rpx;
  line-height: 56rpx;
  font-size: 22rpx;
  color: var(--color-brand);
  font-weight: 600;
}
