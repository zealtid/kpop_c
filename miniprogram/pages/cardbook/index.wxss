.empty-state {
  margin-top: 80rpx;
}

.group-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--color-bg-elevated);
  border: 1rpx solid var(--color-border-subtle);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-top: 20rpx;
}
.left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}
.dot {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
}
.name {
  font-size: 32rpx;
  font-weight: 700;
}
.en {
  color: var(--color-text-secondary);
  font-size: 22rpx;
  margin-top: 4rpx;
}
.ring {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 8rpx solid var(--color-progress-fill);
  background: var(--color-progress-track);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.pct {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-brand);
}
.frac {
  font-size: 18rpx;
  color: var(--color-text-tertiary);
}

.add-custom {
  margin-top: 24rpx;
}

.custom-block {
  margin-top: 28rpx;
}

.custom-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
