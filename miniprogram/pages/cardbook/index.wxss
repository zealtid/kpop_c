.empty-state {
  margin-top: 48rpx;
}

.head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.head-row .h1 {
  flex: 1;
}

.slim-add {
  margin-top: 0;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  flex-shrink: 0;
  white-space: nowrap;
}

.group-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--color-bg-elevated);
  border: 1rpx solid var(--color-border-subtle);
  border-radius: 20rpx;
  padding: 20rpx;
  margin-top: 16rpx;
}
.left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}
.dot {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: var(--color-bg-muted);
  object-fit: cover;
}
.dot.letter {
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
.name {
  font-size: 30rpx;
  font-weight: 700;
}
.ring {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  border: 6rpx solid var(--color-progress-fill);
  background: var(--color-progress-track);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.pct {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-brand);
}
.frac {
  font-size: 18rpx;
  color: var(--color-text-tertiary);
}

.custom-block {
  margin-top: 16rpx;
}

.custom-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.mini {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--color-brand);
}
