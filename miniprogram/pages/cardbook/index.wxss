.album.page {
  padding: 24rpx 24rpx 40rpx;
}

.head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.head-title {
  flex: 1;
  min-width: 0;
}

.head-title .h1 {
  font-size: 40rpx;
  line-height: 1.2;
}

.head-count {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.slim-add {
  margin-top: 0;
  min-height: 72rpx;
  line-height: 72rpx;
  padding: 0 28rpx;
  font-size: 24rpx;
  flex-shrink: 0;
  white-space: nowrap;
  box-sizing: border-box;
}

.group-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--color-bg-elevated);
  border: 1rpx solid var(--color-border-subtle);
  border-radius: 20rpx;
  padding: 20rpx 20rpx 20rpx 16rpx;
  margin-top: 12rpx;
  min-height: 96rpx;
  box-sizing: border-box;
}

.left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.dot {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
  background: var(--color-bg-muted);
  object-fit: cover;
}

.dot.letter {
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.group-meta {
  flex: 1;
  min-width: 0;
}

.name {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bar {
  margin-top: 10rpx;
  height: 8rpx;
  width: 100%;
  max-width: 280rpx;
  background: var(--color-progress-track);
  border-radius: 999rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  background: var(--color-progress-fill);
  border-radius: 999rpx;
}

.group-meta .footnote {
  margin-top: 8rpx;
  font-size: 20rpx;
}

.count-col {
  flex-shrink: 0;
  margin-left: 16rpx;
  text-align: right;
  min-width: 96rpx;
}

.frac {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  line-height: 1.2;
}

.pct {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--color-brand);
  font-weight: 600;
}

.empty-state {
  margin-top: 48rpx;
  padding: 48rpx 32rpx;
}

.empty-actions {
  margin-top: 32rpx;
}

.empty-state .btn {
  margin-top: 0;
}

.empty-state .btn + .btn {
  margin-top: 16rpx;
}

.custom-block {
  margin-top: 28rpx;
}

.custom-head {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin-bottom: 8rpx;
}

.grid3 {
  margin: 0 -6rpx;
}

.grid3 .tile {
  padding: 6rpx;
}

.ph {
  padding-top: 150%;
  border-radius: 16rpx;
}

.tile-name {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.3;
  font-weight: 600;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tile-act {
  margin-top: 4rpx;
  min-height: 56rpx;
  line-height: 56rpx;
  font-size: 22rpx;
  color: var(--color-brand);
  font-weight: 600;
}
