<view class="page">
  <view class="h1">关注你喜欢的组合</view>
  <view class="sub">选择 1–3 个组合，卡册会展示他们的收集进度。也可以先跳过，之后再选。</view>
  <view class="muted count">已选 {{selectedCount}}/3</view>

  <view
    wx:for="{{groups}}"
    wx:key="id"
    class="group-card {{item.selected ? 'on' : ''}}"
    bindtap="toggle"
    data-id="{{item.id}}"
  >
    <view class="left">
      <view class="dot" style="background: {{item.logoColor}}"></view>
      <view>
        <view class="name">{{item.nameZh}}</view>
        <view class="en">{{item.nameEn}}</view>
        <view wx:if="{{item.scopeNote}}" class="footnote">{{item.scopeNote}}</view>
      </view>
    </view>
    <view class="tag {{item.selected ? 'on' : ''}}">{{item.selected ? '已选' : '选择'}}</view>
  </view>

  <view class="actions">
    <view class="btn {{canComplete && !saving ? '' : 'disabled'}}" bindtap="complete">进入卡册</view>
    <view class="btn ghost" bindtap="skip">跳过</view>
  </view>
</view>
