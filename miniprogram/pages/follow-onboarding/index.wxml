<view class="page">
  <view class="h1">关注你喜欢的组合</view>
  <follow-picker
    groups="{{groups}}"
    mode="onboarding"
    max-count="{{maxCount}}"
    min-count="{{minCount}}"
    complete-text="进入收藏"
    show-skip="{{true}}"
    show-search="{{true}}"
    show-clear="{{true}}"
    saving="{{saving}}"
    hint="{{hint}}"
    bind:toggle="onToggle"
    bind:clear="onClear"
    bind:complete="complete"
    bind:skip="skip"
  />
</view>
