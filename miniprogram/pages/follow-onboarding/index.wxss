.count {
  margin-top: 20rpx;
}

.group-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--color-bg-elevated);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-top: 20rpx;
  border: 2rpx solid var(--color-border-subtle);
}

.group-card.on {
  border-color: var(--color-brand);
  background: var(--color-brand-soft);
}

.left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}

.dot {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.name {
  font-size: 32rpx;
  font-weight: 700;
}

.en {
  color: var(--color-text-secondary);
  font-size: 22rpx;
  margin-top: 4rpx;
}

.tag {
  margin-top: 0;
  flex-shrink: 0;
}

.tag.on {
  background: var(--color-brand);
  color: var(--color-text-inverse);
}

.actions {
  margin-top: 48rpx;
}

.btn.disabled {
  opacity: 0.4;
}
