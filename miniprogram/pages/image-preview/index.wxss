.preview-page {
  min-height: 100vh;
  background: #000;
  position: relative;
}

.area {
  width: 100vw;
  height: 92vh;
}

.mv {
  width: 100%;
  height: 100%;
}

.full {
  width: 100%;
  height: 100%;
}

.hint {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 24rpx;
  text-align: center;
  color: #8a8494;
  font-size: 22rpx;
  pointer-events: none;
}
