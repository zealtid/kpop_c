<view class="page">
  <view class="h1">投稿图鉴</view>
  <view wx:if="{{pageLoading}}" class="page-loading">加载中…</view>
  <view class="sub">白名单组合内提交单卡，审核通过后进入公开图鉴。卡面必填，卡背可跳过。</view>

  <view wx:if="{{warnings.length}}" class="card warn">
    <view wx:for="{{warnings}}" wx:key="code" class="muted">{{item.message}}</view>
  </view>

  <view class="card">
    <view class="label">组合（仅已开放投稿）</view>
    <view wx:if="{{groupsEmpty}}" class="muted">当前没有开放投稿的组合</view>
    <view class="chips">
      <view
        class="chip {{groupId===item.id?'on':''}}"
        wx:for="{{groups}}"
        wx:key="id"
        bindtap="pickGroup"
        data-id="{{item.id}}"
      >{{item.nameZh}}</view>
    </view>
  </view>

  <view class="card">
    <view class="label">专辑</view>
    <view wx:if="{{!groupId}}" class="muted">请先选择组合</view>
    <view class="chips">
      <view
        class="chip {{releaseId===item.id?'on':''}}"
        wx:for="{{releases}}"
        wx:key="id"
        bindtap="pickRelease"
        data-id="{{item.id}}"
      >{{item.label}}</view>
    </view>
    <view class="label sub-label">成员（选填）</view>
    <view class="chips">
      <view class="chip {{memberId===''?'on':''}}" bindtap="pickMember" data-id="">不指定</view>
      <view
        class="chip {{memberId===item.id?'on':''}}"
        wx:for="{{members}}"
        wx:key="id"
        bindtap="pickMember"
        data-id="{{item.id}}"
      >{{item.nameEn}}</view>
    </view>
    <view class="label sub-label">版本</view>
    <input class="box input" value="{{versionLabel}}" bindinput="onVersion" placeholder="例如 Photobook A / 特典-POB" maxlength="40"/>
    <view class="label sub-label">名称/别称</view>
    <input class="box input" value="{{slotLabel}}" bindinput="onSlot" placeholder="例如 成员小卡 01 / 别称" maxlength="80"/>
    <view class="label sub-label">通路 / 特典</view>
    <input
      class="box input"
      value="{{channelQ}}"
      bindinput="onChannelQ"
      bindfocus="onChannelFocus"
      placeholder="搜索 Weverse / 天猫 / 预购特典"
      maxlength="40"
    />
    <view class="chips channel-hits">
      <view
        class="chip {{channelValue===item.value?'on':''}}"
        wx:for="{{channelHits}}"
        wx:key="key"
        bindtap="pickChannel"
        data-value="{{item.value}}"
        data-label="{{item.label}}"
      >{{item.label}}</view>
    </view>
    <input
      wx:if="{{channelOther}}"
      class="box input"
      value="{{channelCustom}}"
      bindinput="onChannelCustom"
      placeholder="没有匹配时手填通路或特典名称"
      maxlength="40"
    />
  </view>

  <view class="card">
    <view class="faces-row">
      <view class="face-col">
        <view class="label">卡面（必填，{{aspectLabel}}）</view>
        <view class="card-face">
          <image wx:if="{{frontPreview}}" src="{{frontPreview}}" mode="aspectFill"/>
          <view wx:else class="card-face-hint">选图后裁剪</view>
        </view>
        <view class="row pick-row">
          <view class="btn ghost slim" bindtap="pickFront">选卡面</view>
        </view>
      </view>
      <view class="face-col">
        <view class="label">卡背（可跳过）</view>
        <view class="card-face">
          <image wx:if="{{backPreview}}" src="{{backPreview}}" mode="aspectFill"/>
          <view wx:else class="card-face-hint">可跳过</view>
        </view>
        <view class="row pick-row">
          <view class="btn ghost slim" bindtap="pickBack">选卡背</view>
          <view wx:if="{{backPreview}}" class="btn ghost slim" bindtap="skipBack">跳过</view>
        </view>
      </view>
    </view>
  </view>

  <view class="card">
    <view
      class="agree {{agreed?'on':''}} {{saving?'off':''}}"
      bindtap="toggleAgree"
      hover-class="agree-hover"
    >
      <view class="agree-box" aria-role="checkbox" aria-checked="{{agreed}}">
        <view wx:if="{{agreed}}" class="agree-mark"></view>
      </view>
      <view class="agree-text">我确认图片不侵犯第三方权利，同意审核与去重规则</view>
    </view>
  </view>

  <view class="btn {{saving?'off':''}}" bindtap="submit">{{saving ? '提交中…' : '提交审核'}}</view>
</view>
