.preview {
  width: 100%;
  height: 420rpx;
  border-radius: 16rpx;
}
.pick {
  padding-top: 0;
  height: 280rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-muted);
  color: var(--color-text-secondary);
}
.input {
  min-height: 72rpx;
  height: 72rpx;
}
.label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 16rpx;
}
.sub-label {
  margin-top: 20rpx;
}
.warn {
  border: 1rpx solid var(--color-warning);
}
.pick-row {
  margin-top: 16rpx;
  gap: 16rpx;
  flex-wrap: wrap;
}

.pick-row .btn.slim {
  flex: 1;
  min-width: 160rpx;
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.pick-row .btn + .btn {
  margin-top: 0;
}
