.input {
  min-height: 72rpx;
  height: 72rpx;
}
.box {
  width: 100%;
  background: var(--color-bg-muted);
  border: 1rpx solid var(--color-border-subtle);
  border-radius: 16rpx;
  padding: 16rpx;
  color: var(--color-text-primary);
  box-sizing: border-box;
}
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 16rpx;
}
.sub-label {
  margin-top: 20rpx;
}
.warn {
  border: 1rpx solid var(--color-warning);
}
.faces-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}
.face-col {
  flex: 1;
  min-width: 0;
}
.pick-row {
  margin-top: 16rpx;
  gap: 16rpx;
  flex-wrap: wrap;
}

.face-col .pick-row .btn.slim {
  flex: 1;
  min-width: 0;
  padding: 12rpx 8rpx;
  font-size: 24rpx;
  box-sizing: border-box;
}

.pick-row .btn + .btn {
  margin-top: 0;
}

/* 与 .input 同高；勿用全局 .ph（竖图 padding-top:154%） */
.channel-field {
  height: 72rpx;
  min-height: 72rpx;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}
.channel-field .channel-ph {
  color: var(--color-text-tertiary);
  line-height: 1.4;
}

.agree {
  display: flex;
  align-items: flex-start;
  min-height: 88rpx;
  padding: 8rpx 0;
  gap: 16rpx;
}
.agree.off {
  opacity: 0.45;
  pointer-events: none;
}
.agree-hover {
  opacity: 0.85;
}
.agree-box {
  width: 40rpx;
  height: 40rpx;
  margin-top: 4rpx;
  flex-shrink: 0;
  box-sizing: border-box;
  border: 3rpx solid var(--color-text-secondary);
  border-radius: 8rpx;
  background: var(--color-bg-elevated);
  display: flex;
  align-items: center;
  justify-content: center;
}
.agree.on .agree-box {
  border-color: var(--color-brand);
  background: var(--color-brand);
}
.agree-mark {
  width: 18rpx;
  height: 10rpx;
  border-left: 4rpx solid var(--color-text-inverse);
  border-bottom: 4rpx solid var(--color-text-inverse);
  transform: rotate(-45deg) translate(1rpx, -2rpx);
}
.agree-text {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--color-text-secondary);
}
.agree.on .agree-text {
  color: var(--color-text-primary);
}
