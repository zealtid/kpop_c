.badge-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.badge-row .tag {
  margin-top: 0;
}

.label {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
}

.countdown-card {
  text-align: center;
}

.countdown-lg {
  color: var(--color-danger);
  font-size: 48rpx;
  font-weight: 700;
}

.countdown-lg.done {
  color: var(--color-text-secondary);
  font-size: 32rpx;
}

.url {
  word-break: break-all;
}
