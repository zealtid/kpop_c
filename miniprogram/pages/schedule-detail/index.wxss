.badge-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.badge-row .tag {
  margin-top: 0;
}

.tag.trust {
  color: #ff8fb8;
}

.label {
  font-size: 24rpx;
  color: #a9a3b3;
  margin-bottom: 12rpx;
}

.countdown-card {
  text-align: center;
}

.countdown-lg {
  color: #ff6b9d;
  font-size: 48rpx;
  font-weight: 700;
}

.countdown-lg.done {
  color: #8a8494;
  font-size: 32rpx;
}

.url {
  word-break: break-all;
}
