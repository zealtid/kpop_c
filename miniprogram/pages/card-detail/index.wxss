/* custom-card 仍引用本文件，保留原 hero 布局以免影响自定义卡页 */
.hero {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
  align-items: flex-start;
}

.ph.hero-ph {
  width: 200rpx;
  height: 300rpx;
  padding-top: 0;
  aspect-ratio: 2 / 3;
  flex-shrink: 0;
}

.meta {
  flex: 1;
  padding-top: 8rpx;
}

.faces-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.face-col {
  flex: 1;
  min-width: 0;
}

.detail-meta {
  margin-top: 28rpx;
}

.detail-meta .h1 {
  margin-bottom: 4rpx;
}

.detail-meta .tag {
  margin-top: 16rpx;
}

.tag.benefit {
  background: var(--color-warning);
  color: var(--color-text-inverse);
}

.stats-slot {
  min-height: 48rpx;
  margin-top: 24rpx;
}

.page.has-action-bar {
  padding-bottom: calc(220rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  background: var(--color-bg-page);
  border-top: 1rpx solid var(--color-border-subtle);
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 16rpx;
}

.stepper {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 12rpx;
}

.step {
  width: 72rpx;
  height: 72rpx;
  line-height: 68rpx;
  text-align: center;
  border-radius: 16rpx;
  background: var(--color-brand-soft);
  font-size: 40rpx;
  color: var(--color-brand);
}

.qty {
  min-width: 64rpx;
  text-align: center;
  font-size: 40rpx;
  font-weight: 700;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  padding: 10rpx 20rpx;
  margin-right: 0;
}

.box {
  width: 100%;
  min-height: 180rpx;
  background: var(--color-bg-muted);
  border: 1rpx solid var(--color-border-subtle);
  border-radius: 16rpx;
  padding: 16rpx;
  color: var(--color-text-primary);
  box-sizing: border-box;
}

.btn.off {
  opacity: 0.5;
}

.catalog-actions {
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.catalog-actions .btn.slim {
  flex: 1;
  padding: 16rpx 24rpx;
}

.catalog-actions .btn + .btn {
  margin-top: 0;
}

.action-bar .report {
  margin-top: 0;
}
