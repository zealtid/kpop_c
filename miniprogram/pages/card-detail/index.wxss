.hero {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
  align-items: flex-start;
}

.ph.hero-ph {
  width: 200rpx;
  height: 300rpx;
  padding-top: 0;
  aspect-ratio: 2 / 3;
  flex-shrink: 0;
}

.meta {
  flex: 1;
  padding-top: 8rpx;
}

.label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 16rpx;
}

.stepper {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 12rpx;
}

.step {
  width: 72rpx;
  height: 72rpx;
  line-height: 68rpx;
  text-align: center;
  border-radius: 16rpx;
  background: var(--color-brand-soft);
  font-size: 40rpx;
  color: var(--color-brand);
}

.qty {
  min-width: 64rpx;
  text-align: center;
  font-size: 40rpx;
  font-weight: 700;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  padding: 10rpx 20rpx;
  margin-right: 0;
}

.box {
  width: 100%;
  min-height: 180rpx;
  background: var(--color-bg-muted);
  border: 1rpx solid var(--color-border-subtle);
  border-radius: 16rpx;
  padding: 16rpx;
  color: var(--color-text-primary);
  box-sizing: border-box;
}

.btn.off {
  opacity: 0.5;
}

.catalog-actions {
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.catalog-actions .btn.slim {
  flex: 1;
  padding: 16rpx 24rpx;
}

.catalog-actions .btn + .btn {
  margin-top: 0;
}
