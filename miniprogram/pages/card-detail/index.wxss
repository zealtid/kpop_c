.hero {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
  align-items: flex-start;
}

.hero-ph {
  width: 200rpx;
  padding-top: 308rpx;
  flex-shrink: 0;
}

.meta {
  flex: 1;
  padding-top: 8rpx;
}

.label {
  font-size: 26rpx;
  color: #a9a3b3;
  margin-bottom: 16rpx;
}

.stepper {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 12rpx;
}

.step {
  width: 72rpx;
  height: 72rpx;
  line-height: 68rpx;
  text-align: center;
  border-radius: 16rpx;
  background: #2a2233;
  font-size: 40rpx;
  color: #ff8fb8;
}

.qty {
  min-width: 64rpx;
  text-align: center;
  font-size: 40rpx;
  font-weight: 700;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #2a2233;
  color: #a9a3b3;
  font-size: 24rpx;
}

.chip.on {
  background: #ff6b9d;
  color: #fff;
}

.box {
  width: 100%;
  min-height: 180rpx;
  background: #121016;
  border-radius: 16rpx;
  padding: 16rpx;
  color: #f4f1f6;
  box-sizing: border-box;
}

.btn.off {
  opacity: 0.5;
}
