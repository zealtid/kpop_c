<view class="page {{catalogMode ? 'has-action-bar' : ''}}">
  <view wx:if="{{missing}}" class="empty">{{catalogMode ? '卡片不存在' : '尚未拥有该卡'}}</view>

  <block wx:else>
    <view class="faces-row">
      <view class="face-col">
        <view class="card-face" style="background: {{card.memberColor || '#EBEDF3'}}">
          <image wx:if="{{card.mainImageUrl}}" src="{{card.mainImageUrl}}" mode="aspectFill"/>
        </view>
      </view>
      <view class="face-col">
        <view class="card-face" style="background: {{card.memberColor || '#EBEDF3'}}">
          <image wx:if="{{card.imageBack}}" src="{{card.imageBack}}" mode="aspectFill"/>
          <view wx:else class="card-face-hint">暂无卡背</view>
        </view>
      </view>
    </view>

    <view class="detail-meta">
      <view class="h1">{{card.memberNameEn || card.name || '卡片'}}</view>
      <view wx:if="{{card.memberNameZh}}" class="sub">{{card.memberNameZh}}</view>
      <view wx:if="{{card.versionChip}}" class="tag {{card.isBenefit ? 'benefit' : ''}}">{{card.versionChip}}</view>
      <view class="sub">
        <text wx:if="{{card.groupNameZh}}">{{card.groupNameZh}}</text>
        <text wx:if="{{card.groupNameZh && card.releaseTitle}}"> · </text>
        <text wx:if="{{card.releaseTitle}}">{{card.releaseTitle}}</text>
        <text wx:if="{{(card.groupNameZh || card.releaseTitle) && card.version}}"> · </text>
        <text wx:if="{{card.version}}">{{card.version}}</text>
      </view>
      <!-- 后续：拥有人数 / 想要人数等统计 -->
      <view class="stats-slot"></view>
    </view>

    <block wx:if="{{catalogMode}}">
      <view class="action-bar">
        <view class="row catalog-actions">
          <view class="btn slim" bindtap="ownOne">拥有</view>
          <view class="btn ghost slim" bindtap="wantOne">想要</view>
        </view>
        <view class="btn ghost report" bindtap="report">举报此卡</view>
      </view>
    </block>
    <block wx:else>
      <view class="card">
        <view class="label">数量</view>
        <view class="stepper">
          <view class="step" bindtap="decQty">−</view>
          <view class="qty">{{quantity}}</view>
          <view class="step" bindtap="incQty">+</view>
        </view>
        <view class="muted">至少 1 张。撤回到 0 请在收藏里「撤销拥有」。</view>
      </view>

      <view class="card">
        <view class="label">品相</view>
        <view class="chips">
          <view
            class="chip {{condition===item.value?'on':''}}"
            wx:for="{{conditions}}"
            wx:key="value"
            bindtap="pickCondition"
            data-value="{{item.value}}"
          >{{item.label}}</view>
        </view>
      </view>

      <view class="card">
        <view class="label">备注</view>
        <textarea
          class="box"
          maxlength="500"
          value="{{notes}}"
          bindinput="onNotes"
          placeholder="选填，仅自己可见"
        />
        <view class="muted">{{notes.length}}/500</view>
      </view>

      <view class="btn {{saving?'off':''}}" bindtap="save">保存</view>
      <view class="btn ghost" bindtap="setCover">设为封面</view>
      <view class="btn ghost" bindtap="report">举报此卡</view>
    </block>
  </block>
</view>
