<view class="page">
  <view wx:if="{{missing}}" class="empty">尚未拥有该卡</view>

  <block wx:else>
    <view class="hero">
      <view class="ph hero-ph" style="background: {{card.memberColor || '#EBEDF3'}}">
        <image wx:if="{{card.mainImageUrl}}" src="{{card.mainImageUrl}}" mode="aspectFill"/>
      </view>
      <view class="meta">
        <view class="h1">{{card.memberNameEn || '卡片'}}</view>
        <view class="sub">{{card.memberNameZh}}</view>
        <view class="sub">{{card.releaseTitle}} · {{card.version}}</view>
        <view wx:if="{{card.isBenefit}}" class="tag">特典</view>
      </view>
    </view>

    <view class="card">
      <view class="label">数量</view>
      <view class="stepper">
        <view class="step" bindtap="decQty">−</view>
        <view class="qty">{{quantity}}</view>
        <view class="step" bindtap="incQty">+</view>
      </view>
      <view class="muted">至少 1 张。撤回到 0 请在卡册里「撤销拥有」。</view>
    </view>

    <view class="card">
      <view class="label">品相</view>
      <view class="chips">
        <view
          class="chip {{condition===item.value?'on':''}}"
          wx:for="{{conditions}}"
          wx:key="value"
          bindtap="pickCondition"
          data-value="{{item.value}}"
        >{{item.label}}</view>
      </view>
    </view>

    <view class="card">
      <view class="label">备注</view>
      <textarea
        class="box"
        maxlength="500"
        value="{{notes}}"
        bindinput="onNotes"
        placeholder="选填，仅自己可见"
      />
      <view class="muted">{{notes.length}}/500</view>
    </view>

    <view class="btn {{saving?'off':''}}" bindtap="save">保存</view>
  </block>
</view>
