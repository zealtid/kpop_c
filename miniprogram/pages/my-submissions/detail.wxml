<view class="page">
  <view class="h1">{{item.slotLabel}}</view>
  <view class="sub">{{item.statusLabel}}</view>
  <view class="faces">
    <view wx:if="{{item.imageFront}}" class="face">
      <view class="muted face-label">卡面</view>
      <view class="card-face">
        <image src="{{item.imageFront}}" mode="aspectFill"/>
      </view>
    </view>
    <view wx:if="{{item.imageBack}}" class="face">
      <view class="muted face-label">卡背</view>
      <view class="card-face">
        <image src="{{item.imageBack}}" mode="aspectFill"/>
      </view>
    </view>
  </view>
  <view wx:if="{{item.rejectReason}}" class="card footnote">驳回原因：{{item.rejectReason}}</view>
  <view class="muted">{{item.groupNameZh}} · {{item.releaseTitle}} · {{item.versionLabel}}</view>
</view>
