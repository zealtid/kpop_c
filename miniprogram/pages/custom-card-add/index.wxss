.pick {
  padding-top: 0;
  height: 280rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-muted);
  color: var(--color-text-secondary);
}

.preview {
  width: 100%;
  height: 420rpx;
  border-radius: 16rpx;
}

.input {
  min-height: 72rpx;
  height: 72rpx;
}

.label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 16rpx;
}

.stepper {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.step {
  width: 72rpx;
  height: 72rpx;
  line-height: 68rpx;
  text-align: center;
  border-radius: 16rpx;
  background: var(--color-brand-soft);
  font-size: 40rpx;
  color: var(--color-brand);
}

.qty {
  min-width: 64rpx;
  text-align: center;
  font-size: 40rpx;
  font-weight: 700;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  padding: 10rpx 20rpx;
  margin-right: 0;
}

.box {
  width: 100%;
  min-height: 140rpx;
  background: var(--color-bg-muted);
  border: 1rpx solid var(--color-border-subtle);
  border-radius: 16rpx;
  padding: 16rpx;
  color: var(--color-text-primary);
  box-sizing: border-box;
}

.btn.off {
  opacity: 0.5;
}

.pick-row {
  margin-top: 16rpx;
  gap: 16rpx;
  flex-wrap: wrap;
}

.pick-row .btn.slim {
  flex: 1;
  padding: 16rpx 0;
  font-size: 26rpx;
}

.pick-row .btn + .btn {
  margin-top: 0;
}

.sub-label {
  margin-top: 20rpx;
}
