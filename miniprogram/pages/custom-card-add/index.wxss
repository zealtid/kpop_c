.pick {
  padding-top: 0;
  height: 280rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #2a2233;
  color: #8a8494;
}

.preview {
  width: 100%;
  height: 420rpx;
  border-radius: 16rpx;
}

.input {
  min-height: 72rpx;
  height: 72rpx;
}

.label {
  font-size: 26rpx;
  color: #a9a3b3;
  margin-bottom: 16rpx;
}

.stepper {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.step {
  width: 72rpx;
  height: 72rpx;
  line-height: 68rpx;
  text-align: center;
  border-radius: 16rpx;
  background: #2a2233;
  font-size: 40rpx;
  color: #ff8fb8;
}

.qty {
  min-width: 64rpx;
  text-align: center;
  font-size: 40rpx;
  font-weight: 700;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #2a2233;
  color: #a9a3b3;
  font-size: 24rpx;
}

.chip.on {
  background: #ff6b9d;
  color: #fff;
}

.box {
  width: 100%;
  min-height: 140rpx;
  background: #121016;
  border-radius: 16rpx;
  padding: 16rpx;
  color: #f4f1f6;
  box-sizing: border-box;
}

.btn.off {
  opacity: 0.5;
}

.pick-row {
  margin-top: 16rpx;
  gap: 16rpx;
}

.pick-row .btn.slim {
  flex: 1;
  padding: 16rpx 0;
  font-size: 26rpx;
}

.pick-row .btn + .btn {
  margin-top: 0;
}
