<view class="page">
  <view class="h1">拍照加卡</view>
  <view class="sub">仅自己可见，不进入公开图鉴，不计入官方进度。正面须裁成 {{aspectLabel}} 竖图。</view>

  <view class="card">
    <view class="label">正面照片（{{aspectLabel}}）</view>
    <image wx:if="{{preview}}" class="preview" src="{{preview}}" mode="aspectFill"/>
    <view wx:else class="ph pick">选图后必须裁剪，不可跳过</view>
    <view class="row pick-row">
      <view class="btn ghost slim" bindtap="pickAlbum">相册</view>
      <view class="btn ghost slim" bindtap="pickCamera">相机</view>
    </view>
  </view>

  <view class="card">
    <view class="label">标题（选填）</view>
    <input class="box input" value="{{title}}" bindinput="onTitle" placeholder="例如：现场拍的小卡" maxlength="80"/>
  </view>

  <view class="card">
    <view class="label">关联组合（选填）</view>
    <view class="chips">
      <view class="chip {{groupId===''?'on':''}}" bindtap="pickGroup" data-id="">不关联</view>
      <view
        class="chip {{groupId===item.id?'on':''}}"
        wx:for="{{groups}}"
        wx:key="id"
        bindtap="pickGroup"
        data-id="{{item.id}}"
      >{{item.nameZh}}</view>
    </view>
  </view>

  <view wx:if="{{showMembers}}" class="card">
    <view class="label">成员（选填，可跳过）</view>
    <view wx:if="{{membersEmpty}}" class="muted">该组合暂无成员，可跳过</view>
    <view class="chips">
      <view class="chip {{memberId===''?'on':''}}" bindtap="pickMember" data-id="">不指定</view>
      <view
        class="chip {{memberId===item.id?'on':''}}"
        wx:for="{{members}}"
        wx:key="id"
        bindtap="pickMember"
        data-id="{{item.id}}"
      >{{item.nameEn}}</view>
    </view>
  </view>

  <view class="card">
    <view class="label">数量</view>
    <view class="stepper">
      <view class="step" bindtap="decQty">−</view>
      <view class="qty">{{quantity}}</view>
      <view class="step" bindtap="incQty">+</view>
    </view>
  </view>

  <view class="card">
    <view class="label">品相（选填）</view>
    <view class="chips">
      <view
        class="chip {{condition===item.value?'on':''}}"
        wx:for="{{conditions}}"
        wx:key="value"
        bindtap="pickCondition"
        data-value="{{item.value}}"
      >{{item.label}}</view>
    </view>
  </view>

  <view class="card">
    <view class="label">备注（选填）</view>
    <textarea class="box" maxlength="500" value="{{note}}" bindinput="onNote" placeholder="仅自己可见"/>
  </view>

  <view class="btn {{saving?'off':''}}" bindtap="save">保存到卡册</view>
</view>
