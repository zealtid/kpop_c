.album.page {
  padding: 24rpx 24rpx 40rpx;
}

.head-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
}

.head-title .h1 {
  font-size: 36rpx;
  line-height: 1.2;
}

.head-count {
  margin-top: 6rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
}

.scope {
  margin-top: 8rpx;
  font-size: 20rpx;
}

.actions {
  margin: 20rpx 0 4rpx;
  gap: 12rpx;
}

.actions .btn {
  flex: 1;
  margin-top: 0;
}

.btn.slim {
  min-height: 72rpx;
  padding: 0 16rpx;
  font-size: 26rpx;
  line-height: 72rpx;
  box-sizing: border-box;
}

.tabs {
  margin: 16rpx 0 12rpx;
}

.tabs .item {
  min-height: 72rpx;
  padding: 0;
  line-height: 72rpx;
  font-size: 26rpx;
}

.custom-head {
  margin: 8rpx 0;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.grid3 {
  margin: 0 -6rpx;
}

.grid3 .tile {
  padding: 6rpx;
}

.ph {
  padding-top: 150%;
  border-radius: 16rpx;
}

.qty-badge {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  z-index: 1;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.2;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(26, 27, 31, 0.72);
  color: var(--color-text-inverse);
}

.tile-name {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.3;
  font-weight: 600;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tile-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
  margin-top: 6rpx;
  min-height: 0;
}

.tile-chip {
  display: inline-flex;
  align-items: center;
  max-width: 100%;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: var(--color-brand-soft);
  color: var(--color-brand);
  font-size: 18rpx;
  line-height: 1.3;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tile-chip.mute {
  background: var(--color-bg-muted);
  color: var(--color-text-secondary);
}

.tile-act {
  margin-top: 4rpx;
  min-height: 56rpx;
  line-height: 56rpx;
  font-size: 22rpx;
  color: var(--color-brand);
  font-weight: 600;
}

.empty-state.compact {
  margin-top: 24rpx;
  padding: 40rpx 28rpx;
}

.empty-actions {
  margin-top: 28rpx;
}

.empty-state .btn {
  margin-top: 0;
}

.empty-state .btn + .btn {
  margin-top: 12rpx;
}

.empty-state.compact .empty-actions {
  display: flex;
  gap: 12rpx;
}

.empty-state.compact .btn {
  flex: 1;
}

.empty-state.compact .btn + .btn {
  margin-top: 0;
}
