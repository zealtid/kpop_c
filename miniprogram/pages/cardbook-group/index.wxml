<view class="page album">
  <view class="head-row">
    <view class="head-title">
      <view class="h1">{{group.nameZh}}</view>
      <view class="head-count">{{progress.ownedDistinct}} / {{progress.publishedCount}} · {{pct}}%</view>
    </view>
  </view>
  <view wx:if="{{group.scopeNote}}" class="footnote scope">{{group.scopeNote}}</view>

  <view class="row actions">
    <view class="btn slim" bindtap="share">生成长图</view>
    <view class="btn ghost slim" bindtap="addFromCatalog">拍照入册</view>
  </view>

  <view class="tabs">
    <view class="item {{tab===0?'on':''}}" bindtap="setTab" data-i="0">拥有</view>
    <view class="item {{tab===1?'on':''}}" bindtap="setTab" data-i="1">想要</view>
    <view class="item {{tab===2?'on':''}}" bindtap="setTab" data-i="2">重复</view>
  </view>

  <block wx:if="{{tab===0 && custom.length}}">
    <view class="custom-head">历史私人卡 {{custom.length}}</view>
    <view class="grid3">
      <view class="tile" wx:for="{{custom}}" wx:key="id" bindtap="openCustom" data-id="{{item.id}}">
        <view class="ph" style="background: {{item.memberColor || '#EBEDF3'}}" catchtap="openPreview" data-id="{{item.id}}">
          <image wx:if="{{item.mainImageUrl}}" src="{{item.mainImageUrl}}" mode="aspectFill"/>
          <view class="badge">{{item.badge}}</view>
          <view wx:if="{{item.moderationLabel}}" class="badge warn">{{item.moderationLabel}}</view>
          <view wx:if="{{item.quantity > 1}}" class="qty-badge">×{{item.quantity}}</view>
        </view>
        <view class="tile-name">{{item.title || item.memberNameEn || '自定义卡'}}</view>
        <view class="tile-act" catchtap="removeCustom" data-id="{{item.id}}">删除</view>
      </view>
    </view>
  </block>

  <view wx:if="{{list.length===0 && !(tab===0 && custom.length)}}" class="empty-state compact">
    <view class="empty-title">{{emptyTitle}}</view>
    <view class="empty-actions">
      <view class="btn slim" bindtap="goCatalog">去图鉴</view>
      <view class="btn ghost slim" bindtap="addFromCatalog">拍照入册</view>
    </view>
  </view>

  <view class="grid3">
    <view class="tile" wx:for="{{list}}" wx:key="id" hover-class="nav-hover" hover-start-time="20" hover-stay-time="80" bindtap="openCard" data-id="{{item.id}}">
      <view class="ph" style="background: {{item.memberColor}}">
        <image wx:if="{{item.mainImageUrl}}" src="{{item.mainImageUrl}}" mode="aspectFill"/>
        <view wx:if="{{item.quantity > 1}}" class="qty-badge">×{{item.quantity}}</view>
      </view>
      <view class="tile-name">{{item.memberNameEn}}</view>
      <view class="tile-chips">
        <view wx:if="{{item.version}}" class="tile-chip">{{item.version}}</view>
        <view wx:if="{{item.conditionLabel}}" class="tile-chip mute">{{item.conditionLabel}}</view>
      </view>
      <view wx:if="{{tab===0 && item.isCover}}" class="tile-chip">封面</view>
      <view wx:if="{{tab===0 && !item.isCover}}" class="tile-act" catchtap="setCover" data-id="{{item.id}}">设为封面</view>
      <view wx:if="{{tab===0}}" class="tile-act" catchtap="unown" data-id="{{item.id}}">撤销拥有</view>
      <view wx:if="{{tab===1}}" class="tile-act" catchtap="unwant" data-id="{{item.id}}">移除想要</view>
    </view>
  </view>
</view>
