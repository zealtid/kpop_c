<view class="page">
  <view class="h1">{{group.nameZh}}</view>
  <view class="sub">{{progress.ownedDistinct}} / {{progress.publishedCount}} · {{pct}}%</view>
  <view class="sub">{{copy}}</view>
  <view wx:if="{{group.scopeNote}}" class="footnote">{{group.scopeNote}}</view>

  <view class="btn" bindtap="share">生成卡册长图并保存</view>

  <view class="tabs">
    <view class="item {{tab===0?'on':''}}" bindtap="setTab" data-i="0">拥有</view>
    <view class="item {{tab===1?'on':''}}" bindtap="setTab" data-i="1">想要</view>
    <view class="item {{tab===2?'on':''}}" bindtap="setTab" data-i="2">重复</view>
  </view>

  <view wx:if="{{list.length===0}}" class="empty">暂无卡片</view>
  <view class="grid3">
    <view class="tile" wx:for="{{list}}" wx:key="id">
      <view class="ph" style="background: {{item.memberColor}}">
        <image wx:if="{{item.mainImageUrl}}" src="{{item.mainImageUrl}}" mode="aspectFill"/>
      </view>
      <view class="muted">{{item.memberNameEn}}</view>
      <view class="tag">{{item.version}} <text wx:if="{{item.quantity}}">×{{item.quantity}}</text></view>
      <view wx:if="{{tab===0}}" class="mini" catchtap="unown" data-id="{{item.id}}">撤销拥有</view>
      <view wx:if="{{tab===1}}" class="mini" catchtap="unwant" data-id="{{item.id}}">移除想要</view>
    </view>
  </view>
</view>
