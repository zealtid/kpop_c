<view class="page">
  <view class="h1">图鉴</view>
  <view class="sub">搜索专辑或成员，可多选后批量标记拥有。</view>
  <input class="search" placeholder="搜索专辑 / 成员 / 版本" placeholder-style="color:#98A2B3" confirm-type="search" bindconfirm="onSearch" value="{{q}}"/>
  <view class="muted" style="margin-top:12rpx">搜索仅在图鉴，卡册总览不提供搜索。</view>
  <view class="row submit-row">
    <view class="btn ghost submit-entry" bindtap="goSubmit">投稿图鉴</view>
    <view class="btn ghost submit-entry" bindtap="goGrid">宫格入册</view>
  </view>
  <view wx:if="{{pageLoading}}" class="page-loading">加载中…</view>

  <view wx:for="{{groups}}" wx:key="id" class="card" hover-class="nav-hover" hover-start-time="20" hover-stay-time="80" bindtap="openGroup" data-id="{{item.slug}}">
    <view class="row">
      <view class="group-ident">
        <image wx:if="{{item.logoSrc}}" class="group-logo" src="{{item.logoSrc}}" mode="aspectFill"/>
        <view wx:else class="group-logo letter" style="background: {{item.logoColor}}">{{item.initial}}</view>
        <view>
          <view class="h1" style="font-size:32rpx">{{item.nameZh}}</view>
          <view class="muted">{{item.nameEn}}</view>
          <view wx:if="{{item.scopeNote}}" class="footnote">{{item.scopeNote}}</view>
        </view>
      </view>
      <view class="muted">浏览 →</view>
    </view>
  </view>
</view>
