.submit-entry {
  margin: 24rpx 0 8rpx;
}

.group-ident {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}

.group-logo {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  background: var(--color-bg-muted);
  object-fit: cover;
}

.group-logo.letter {
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
