<view class="page">
  <view class="h1">宫格入册</view>
  <view class="sub">拍或选一整页小卡（规则或不规则均可）。服务端识别卡位后确认入册；失败会改走单卡投稿。尽量平铺、少遮挡。</view>

  <view class="card">
    <view
      class="agree {{visionConsent?'on':''}} {{busy?'off':''}}"
      bindtap="toggleConsent"
      hover-class="agree-hover"
    >
      <view class="agree-box" aria-role="checkbox" aria-checked="{{visionConsent}}">
        <view wx:if="{{visionConsent}}" class="agree-mark"></view>
      </view>
      <view class="agree-text">图片将送至第三方视觉识别服务检测卡位，不用于广告。未勾选不可识别。</view>
    </view>
  </view>

  <view class="card">
    <view class="label">整页照片</view>
    <image wx:if="{{preview}}" class="preview" src="{{preview}}" mode="aspectFit"/>
    <view wx:else class="ph pick">相册或相机</view>
    <view class="row pick-row">
      <view class="btn ghost slim {{busy?'off':''}}" bindtap="pickAlbum">相册</view>
      <view class="btn ghost slim {{busy?'off':''}}" bindtap="pickCamera">拍照</view>
    </view>
  </view>

  <view wx:if="{{busy}}" class="muted hint">{{busyText}}</view>
  <view wx:if="{{failHint}}" class="footnote">{{failHint}}</view>

  <view class="card advanced">
    <view class="adv-toggle" bindtap="toggleAdvanced">{{advancedOpen ? '收起手动规则宫格' : '高级：手动四宫 / 九宫（离线切分）'}}</view>
    <view wx:if="{{advancedOpen}}">
      <view class="label">宫格</view>
      <view class="chips">
        <view class="chip {{cells===4?'on':''}}" bindtap="pickCells" data-cells="4">四宫</view>
        <view class="chip {{cells===9?'on':''}}" bindtap="pickCells" data-cells="9">九宫</view>
      </view>
      <view class="muted adv-hint">仅规则 4/9 摆放时使用，不经过第三方视觉服务。</view>
    </view>
  </view>

  <canvas
    canvas-id="detectCanvas"
    class="offscreen"
    style="width: {{canvasW}}px; height: {{canvasH}}px;"
    disable-scroll="true"
  />
</view>
