.preview {
  width: 100%;
  height: 420rpx;
  border-radius: 16rpx;
  background: var(--color-bg-muted);
}
.pick {
  padding-top: 0;
  height: 280rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-muted);
  color: var(--color-text-secondary);
}
.label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 16rpx;
}
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.pick-row {
  margin-top: 16rpx;
  gap: 16rpx;
}
.pick-row .btn.slim {
  flex: 1;
  padding: 16rpx 24rpx;
  font-size: 26rpx;
}
.pick-row .btn + .btn {
  margin-top: 0;
}
.hint {
  text-align: center;
  margin: 16rpx 0 8rpx;
}
.offscreen {
  position: fixed;
  left: -2400px;
  top: 0;
}
