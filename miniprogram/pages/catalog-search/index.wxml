<view class="page">
  <input class="search" value="{{q}}" placeholder-style="color:#98A2B3" confirm-type="search" bindconfirm="onSearch"/>
  <view class="row" style="margin:20rpx 0">
    <view class="muted">已选 {{selected.length}}</view>
    <view class="btn slim" bindtap="batchOwn">批量拥有</view>
  </view>
  <view wx:if="{{empty}}" class="empty-state">
    <view class="empty-title">没有匹配模板</view>
    <view class="empty-sub">找不到想要的卡时，可以反馈缺卡。</view>
    <view class="btn" bindtap="goFeedback">反馈缺卡</view>
  </view>
  <view class="grid3">
    <view class="tile" wx:for="{{templates}}" wx:key="id" bindtap="toggle" data-id="{{item.id}}">
      <view class="ph {{item.on ? 'sel' : ''}}" style="background: {{item.memberColor}}">
        <image wx:if="{{item.mainImageUrl}}" src="{{item.mainImageUrl}}" mode="aspectFill"/>
      </view>
      <view class="muted">{{item.memberNameEn}}</view>
      <view class="tag">{{item.releaseTitle}} · {{item.version}}</view>
      <view class="row mini-actions">
        <text class="own" catchtap="ownOne" data-id="{{item.id}}">拥有</text>
        <text class="want" catchtap="wantOne" data-id="{{item.id}}">想要</text>
      </view>
    </view>
  </view>
</view>
