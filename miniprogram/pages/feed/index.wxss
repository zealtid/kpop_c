.chip-row {
  white-space: nowrap;
  margin: 20rpx 0 8rpx;
}

.chip {
  display: inline-block;
  padding: 12rpx 24rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: #2a2233;
  color: #a9a3b3;
  font-size: 24rpx;
}

.chip.on {
  background: #ff6b9d;
  color: #fff;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 28rpx 0 12rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
}

.section-link {
  color: #ff8fb8;
  font-size: 24rpx;
}

.today-strip {
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.today-card {
  display: inline-block;
  width: 300rpx;
  margin-right: 16rpx;
  vertical-align: top;
  white-space: normal;
  background: #1c1824;
  border-radius: 20rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.today-kind {
  font-size: 20rpx;
  color: #ff8fb8;
}

.today-title {
  font-size: 28rpx;
  font-weight: 700;
  margin: 8rpx 0;
}

.countdown {
  margin-top: 12rpx;
  color: #ff6b9d;
  font-size: 24rpx;
  font-weight: 700;
}

.countdown.done {
  color: #8a8494;
  font-weight: 400;
}

.strip-empty {
  margin: 8rpx 0 16rpx;
}

.badge-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.badge-row .tag {
  margin-top: 0;
}

.tag.warn {
  color: #f5c36b;
}

.feed-title {
  font-size: 30rpx;
  font-weight: 700;
}

.summary {
  margin-top: 8rpx;
}

.meta {
  margin-top: 16rpx;
}

.link {
  color: #ff8fb8;
  font-size: 22rpx;
}

.empty-state {
  margin-top: 64rpx;
  background: #1c1824;
  border-radius: 32rpx;
  padding: 64rpx 40rpx;
  text-align: center;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
}

.empty-sub {
  color: #8a8494;
  font-size: 24rpx;
  line-height: 1.6;
  margin-top: 12rpx;
}

.empty-state .btn {
  margin-top: 48rpx;
}
