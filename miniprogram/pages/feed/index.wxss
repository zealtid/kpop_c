.chip-row {
  white-space: nowrap;
  margin: 20rpx 0 8rpx;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 28rpx 0 12rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
}

.section-link {
  color: var(--color-brand);
  font-size: 24rpx;
}

.today-strip {
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.today-card {
  display: inline-block;
  width: 300rpx;
  margin-right: 16rpx;
  vertical-align: top;
  white-space: normal;
  background: var(--color-bg-elevated);
  border: 1rpx solid var(--color-border-subtle);
  border-radius: 20rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.today-kind {
  font-size: 20rpx;
  color: var(--color-brand);
}

.today-title {
  font-size: 28rpx;
  font-weight: 700;
  margin: 8rpx 0;
}

.countdown {
  margin-top: 12rpx;
  color: var(--color-danger);
  font-size: 24rpx;
  font-weight: 700;
}

.countdown.done {
  color: var(--color-text-secondary);
  font-weight: 400;
}

.strip-empty {
  margin: 8rpx 0 16rpx;
}

.badge-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.badge-row .tag {
  margin-top: 0;
}

.feed-title {
  font-size: 30rpx;
  font-weight: 700;
}

.summary {
  margin-top: 8rpx;
}

.meta {
  margin-top: 16rpx;
}

.link {
  color: var(--color-brand);
  font-size: 22rpx;
}
