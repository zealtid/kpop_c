.ver-scroll {
  white-space: nowrap;
  margin: 24rpx 0 8rpx;
}

.ver-scroll .chip {
  display: inline-block;
}

.pending-label {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  background: var(--color-bg-muted);
}

.empty-state {
  margin-top: 40rpx;
}
