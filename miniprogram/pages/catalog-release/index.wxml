<view class="page">
  <view class="h1">{{release.title}}</view>
  <view wx:if="{{pageLoading}}" class="page-loading">加载中…</view>
  <view class="muted">{{release.releasedOnLabel}} · {{release.kind}}</view>

  <view wx:if="{{empty && !pageLoading}}" class="empty-state">
    <view class="empty-title">暂无已发布小卡</view>
  </view>

  <view class="grid3" style="margin-top:16rpx">
    <view
      class="tile"
      wx:for="{{templates}}"
      wx:key="id"
      hover-class="nav-hover"
      hover-start-time="20"
      hover-stay-time="80"
      bindtap="openCard"
      data-id="{{item.id}}"
    >
      <view class="ph" style="background: {{item.memberColor}}">
        <image wx:if="{{item.mainImageUrl}}" src="{{item.mainImageUrl}}" mode="aspectFill"/>
      </view>
      <view class="tile-name">{{item.memberNameEn || item.name}}</view>
      <view wx:if="{{item.versionChip}}" class="meta-chips tile-chips">
        <view class="meta-chip {{item.isBenefit ? 'benefit' : ''}}"><text>{{item.versionChip}}</text></view>
      </view>
    </view>
  </view>
</view>
