<view class="page">
  <follow-picker
    groups="{{groups}}"
    mode="manage"
    max-count="{{0}}"
    min-count="{{0}}"
    complete-text="完成"
    show-skip="{{false}}"
    show-search="{{true}}"
    show-clear="{{true}}"
    saving="{{saving}}"
    hint="{{hint}}"
    bind:toggle="onToggle"
    bind:clear="onClear"
    bind:complete="complete"
  />
</view>
