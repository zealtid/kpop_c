.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(17, 18, 23, 0.45);
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  max-height: 80vh;
  background: var(--color-bg-elevated);
  border-radius: 32rpx 32rpx 0 0;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
}

.sheet-done {
  font-size: 28rpx;
  color: var(--color-brand);
  padding: 8rpx 0 8rpx 24rpx;
}

.sheet-hint {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin-bottom: 16rpx;
}

.search {
  width: 100%;
  height: 72rpx;
  min-height: 72rpx;
  background: var(--color-bg-muted);
  border: 1rpx solid var(--color-border-subtle);
  border-radius: 16rpx;
  padding: 0 20rpx;
  color: var(--color-text-primary);
  box-sizing: border-box;
  margin-bottom: 16rpx;
}

.search.custom {
  margin-top: 8rpx;
  margin-bottom: 8rpx;
}

.list {
  height: 52vh;
}

.opt {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 88rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  margin-bottom: 8rpx;
  background: var(--color-bg-page);
}

.opt.on {
  background: var(--color-brand-soft);
}

.opt-main {
  flex: 1;
  font-size: 28rpx;
  line-height: 1.4;
}

.opt-kind {
  flex-shrink: 0;
  font-size: 20rpx;
  color: var(--color-text-tertiary);
}
