@import "styles/theme.wxss";

page {
  background: var(--color-bg-page);
  color: var(--color-text-primary);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  min-height: 100%;
}

/* MP-T05：页内点按 ≤300ms；整页转场走原生 navigate/switchTab/back */
.card,
.group-card,
.action-row,
.tile,
.settings-row,
.chip,
.step {
  transition: opacity 200ms ease, background-color 200ms ease;
}

.nav-hover {
  opacity: 0.72;
}

@media (prefers-reduced-motion: reduce) {
  .card,
  .group-card,
  .action-row,
  .tile,
  .settings-row,
  .chip,
  .step {
    transition: none;
  }

  .nav-hover {
    opacity: 0.88;
  }
}

.page {
  padding: 32rpx;
  padding-bottom: 48rpx;
}

.h1 {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.sub {
  color: var(--color-text-secondary);
  font-size: 24rpx;
  line-height: 1.6;
  margin-top: 12rpx;
}

.footnote {
  margin-top: 16rpx;
  color: var(--color-warning);
  font-size: 22rpx;
}

.card {
  background: var(--color-bg-elevated);
  border: 1rpx solid var(--color-border-subtle);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.btn {
  background: var(--color-button-primary-bg);
  color: var(--color-button-primary-text);
  border-radius: 999rpx;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
}

.btn:active {
  background: var(--color-brand-pressed);
}

.btn.ghost {
  background: var(--color-button-secondary-bg);
  border: 2rpx solid var(--color-button-secondary-border);
  color: var(--color-button-secondary-text);
}

.btn.ghost:active {
  background: var(--color-bg-muted);
}

.btn + .btn {
  margin-top: 16rpx;
}

.btn.off {
  opacity: 0.5;
}

.page-loading {
  text-align: center;
  color: var(--color-text-secondary);
  padding: 48rpx 0;
  font-size: 26rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.muted {
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.grid3 {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

.grid3 .tile {
  width: 33.33%;
  box-sizing: border-box;
  padding: 8rpx;
}

.ph {
  width: 100%;
  padding-top: 154%;
  border-radius: 12rpx;
  position: relative;
  overflow: hidden;
  background: var(--color-bg-muted);
}

.ph image {
  position: absolute;
  /* 真机 WXSS 不支持 inset；无 top/left 时 height:100% 相对 padding 盒为 0，图不显示 */
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
}

/* 投稿/待审卡面竖图 2:3。padding-top 相对自身 width；勿与 aspect-ratio 叠用以免双倍高度 */
.card-face {
  position: relative;
  overflow: hidden;
  width: 100%;
  padding-top: 150%;
  border-radius: 16rpx;
  background: var(--color-bg-muted);
}

.card-face image {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
}

.card-face-hint {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-secondary);
  font-size: 26rpx;
}

.card-face.thumb {
  width: 120rpx;
  height: 180rpx;
  padding-top: 0;
  aspect-ratio: 2 / 3;
  border-radius: 12rpx;
  flex-shrink: 0;
  box-sizing: border-box;
}

.tag {
  display: inline-block;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: var(--color-brand-soft);
  color: var(--color-brand);
  margin-top: 8rpx;
}

.tag.warn {
  background: var(--color-bg-muted);
  color: var(--color-warning);
}

.tag.trust {
  color: var(--color-brand);
}

.tabs {
  display: flex;
  background: var(--color-bg-muted);
  border-radius: 16rpx;
  padding: 6rpx;
  margin: 24rpx 0;
}

.tabs .item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.tabs .item.on {
  background: var(--color-brand);
  color: var(--color-text-inverse);
}

.search {
  background: var(--color-bg-elevated);
  border: 1rpx solid var(--color-border-subtle);
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.empty {
  text-align: center;
  color: var(--color-text-secondary);
  padding: 80rpx 0;
  font-size: 26rpx;
}

.empty-state {
  margin-top: 64rpx;
  background: var(--color-bg-elevated);
  border: 1rpx solid var(--color-border-subtle);
  border-radius: 32rpx;
  padding: 64rpx 40rpx;
  text-align: center;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.empty-sub {
  color: var(--color-text-secondary);
  font-size: 24rpx;
  line-height: 1.6;
  margin-top: 12rpx;
}

.empty-state .btn {
  margin-top: 48rpx;
}

.chip {
  display: inline-block;
  padding: 12rpx 24rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: var(--color-bg-muted);
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.chip.on {
  background: var(--color-brand);
  color: var(--color-text-inverse);
}

.badge {
  position: absolute;
  left: 8rpx;
  bottom: 8rpx;
  font-size: 18rpx;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  background: var(--color-badge-want);
  color: var(--color-text-inverse);
}

.badge.warn {
  left: auto;
  right: 8rpx;
  background: var(--color-warning);
  color: var(--color-text-inverse);
}

.badge.own {
  background: var(--color-badge-own);
}

.mini-actions .own {
  color: var(--color-badge-own);
}

.mini-actions .want {
  color: var(--color-badge-want);
}
