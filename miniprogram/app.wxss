page {
  background: #121016;
  color: #f4f1f6;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  min-height: 100%;
}

.page {
  padding: 32rpx;
  padding-bottom: 48rpx;
}

.h1 {
  font-size: 40rpx;
  font-weight: 700;
}

.sub {
  color: #a9a3b3;
  font-size: 24rpx;
  line-height: 1.6;
  margin-top: 12rpx;
}

.footnote {
  margin-top: 16rpx;
  color: #f5c36b;
  font-size: 22rpx;
}

.card {
  background: #1c1824;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.btn {
  background: #ff6b9d;
  color: #fff;
  border-radius: 999rpx;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
}

.btn.ghost {
  background: transparent;
  border: 2rpx solid #3a3344;
  color: #f4f1f6;
}

.btn + .btn {
  margin-top: 16rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.muted {
  color: #8a8494;
  font-size: 22rpx;
}

.grid3 {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

.grid3 .tile {
  width: 33.33%;
  box-sizing: border-box;
  padding: 8rpx;
}

.ph {
  width: 100%;
  padding-top: 154%;
  border-radius: 12rpx;
  position: relative;
  overflow: hidden;
}

.ph image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.tag {
  display: inline-block;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #2a2233;
  color: #ff8fb8;
  margin-top: 8rpx;
}

.tabs {
  display: flex;
  background: #1c1824;
  border-radius: 16rpx;
  padding: 6rpx;
  margin: 24rpx 0;
}

.tabs .item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #8a8494;
}

.tabs .item.on {
  background: #ff6b9d;
  color: #fff;
}

.search {
  background: #1c1824;
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  font-size: 28rpx;
  color: #f4f1f6;
}

.empty {
  text-align: center;
  color: #8a8494;
  padding: 80rpx 0;
  font-size: 26rpx;
}
