# Build-time API origin for the H5 SPA (Vite). No trailing slash.
# Local `npm run dev:h5` proxies /catalog /share /auth /h5 to VITE_API_PROXY (default http://127.0.0.1:3000)
# and can leave this empty. Production / `npm run build` must set it.
#
# Production H5 entry: https://zealhe.top/h5/
VITE_API_BASE=https://zealhe.top/api
